{
  "name": "sleevebook",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sleevebook/db db:generate",
    "db:migrate": "pnpm --filter @sleevebook/db db:migrate",
    "db:studio": "pnpm --filter @sleevebook/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "5.0.4",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
