DATABASE_URL=postgres://sleevebook:sleevebook@localhost:5433/sleevebook

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_ASSETS_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (producción): client id/secret de Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cuenta que hereda los binders creados antes del login
OWNER_EMAIL=
# Login de desarrollo (correo+contraseña) para dev local y e2e; nunca en producción.
AUTH_DEV_LOGIN=1

# Escaneo con cámara (Claude Vision, modelo claude-haiku-5-5). Sin key, /escanear avisa que no está disponible.
ANTHROPIC_API_KEY=
# Escaneos por usuario por día (por defecto 30)
SCAN_DAILY_LIMIT=30
